::MODULE{FIELDS|title:仅提取可验证字段；价格或有效期未知就省略}
title price currency offer_url valid_from valid_until source_url fetched_at category billing_period commitment_months renewal_price discount_percent coupon_code kind evidence

::MODULE{EXTRACTORS|title:经过人工核对的确定性提取规则；无匹配不生成优惠}
{"provider":"hostinger","mode":"anchored_html","title":"Premium Web Hosting","category":"Web hosting","anchor":"product-slug_hosting:hostinger_premium","window_chars":9000,"currency":"USD","billing_period":"month","field_patterns":{"price":"(?s)h-pricing-card__current-price.{0,800}?hw-price__value[^>]*>(?P<value>[0-9.]+)","discount_percent":"(?i)(?P<value>[0-9]+)% off","commitment_months":"Get (?P<value>[0-9]+) months","renewal_price":"Renews at \\$(?P<value>[0-9.]+)/mo"},"structure":"Hostinger pricing card identified by its product-slug data attribute."}
